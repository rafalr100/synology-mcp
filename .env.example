# ── Connection ────────────────────────────────────────────────────────────────
# Base URL of your Synology NAS (use https://...:5001 if you prefer TLS).
SYNOLOGY_URL=http://192.168.1.100:5000
SYNOLOGY_USER=your_username
SYNOLOGY_PASS=your_password

# ── Two-factor authentication (only if your account has 2FA) ────────────────────
# Leave blank, then run:  python bootstrap_2fa.py <current-OTP-code>
# That fills SYNOLOGY_DEVICE_ID with a persistent trusted-device token so the
# server can log in without an OTP every time.
SYNOLOGY_DEVICE_ID=

# ── Optional behaviour ──────────────────────────────────────────────────────────
# Verify the TLS certificate (set true only if you use a valid cert on https).
# SYNOLOGY_VERIFY_SSL=false
# Request timeout in seconds.
# SYNOLOGY_TIMEOUT=30
# Session / device name shown in DSM's connection list.
# SYNOLOGY_SESSION_NAME=SynologyMCP
# SYNOLOGY_DEVICE_NAME=SynologyMCP

# ── Power control (DESTRUCTIVE — disabled by default) ───────────────────────────
# Set to true to allow reboot_nas / shutdown_nas / install_dsm_update.
# SYNOLOGY_ENABLE_POWER_CONTROL=false
